    {
      "id": "us-abdomen-fasting",
      "text": "Jejum de 4 a 6h.",
      "topic": "fasting",
      "appliesTo": [
        "USABT",
        "USABD"
      ],
      "locator": "parágrafos 30–31",
      "quote": "EXAMES: Abdômen total, Abdômen superior, Biopsia hepática / Jejum de 4 a 6h",
