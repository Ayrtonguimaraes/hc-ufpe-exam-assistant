      "appliesTo": [
        "USABT",
        "USAPU",
        "USGIN",
        "USHOM"
      ],
      "locator": "parágrafos 34–35",
      "quote": "EXAMES: Vias urinárias, Abdômen total, Ultrassonografia pélvica abdominal / O paciente esteja com a bexiga cheia, no setor ele também será orientado a ingerir água para tal.",
      "sourceId": "orientacoes-exames",
      "validation": "pending-udi",
      "documentaryReview": "checked-2026-11-06",
      "modality": "ultrassonografia"
    },
